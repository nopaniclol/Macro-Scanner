                'Switch Ask': '{:+.2f}',
                'Switch Mid': '{:+.2f}',
                'Switch Spread': '{:.2f}',
                'Ann Bid (%)': '{:+.2f}%',
                'Ann Ask (%)': '{:+.2f}%',
                'Ann Mid (%)': '{:+.2f}%',
            }, na_rep='—')
            .applymap(_cell_color_num, subset=[
                'Switch Bid',
                'Switch Ask',
                'Switch Mid',
                'Ann Bid (%)',
                'Ann Ask (%)',
                'Ann Mid (%)',
            ])
            .set_caption(
                f'{name} Switch Levels | Bid = EFP Bid(far) - EFP Ask(near)'
            )
            .set_table_styles([
                {'selector': 'caption', 'props': [('color', C_TEXT), ('font-weight', 'bold'), ('font-size', '11px')]},
                {'selector': 'th', 'props': [('background-color', BG_CARD), ('color', C_TEXT)]},
            ])
        )

        display(styler)

    # ─────────────────────────────────────────────────────────
    #  Charts
    # ─────────────────────────────────────────────────────────

    sofr_chart = sofr_df.dropna(subset=['SOFR (%)']).copy()

    if not sofr_chart.empty:
        fig, ax = plt.subplots(figsize=(14, 4), facecolor=BG_DARK)

        ax.plot(
            sofr_chart['Days'],
            sofr_chart['SOFR (%)'],
            color=C_BLUE,
            marker='o',
            lw=2,
            label='SOFR OIS Curve'
        )

        ax.plot(
            sofr_chart['Days'],
            sofr_chart['Funding Cost (%)'],
            color=C_AMBER,
            marker='x',
            lw=2,
            label='Funding Cost = SOFR + Spread'
        )

        for _, row in sofr_chart.iterrows():
            ax.annotate(
                row['Tenor'],
                (row['Days'], row['SOFR (%)']),
                textcoords="offset points",
                xytext=(0, 6),
                ha='center',
                fontsize=8,
                color=C_MUTED
            )

        ax.set_title('SOFR vs Funding Cost Curve | Cash & Carry Input Only', color=C_TEXT, fontweight='bold')
        ax.set_xlabel('Days', color=C_MUTED)
        ax.set_ylabel('%', color=C_MUTED)
        ax.yaxis.set_major_formatter(plt.FuncFormatter(lambda v, _: f'{v:+.2f}%'))
        ax.grid(True, alpha=0.3)
        ax.legend(fontsize=8)

        plt.tight_layout()
        plt.show()

    # EFP RV Dollar Chart

    fig, axes = plt.subplots(2, 2, figsize=(16, 10), facecolor=BG_DARK)
    fig.suptitle(
        'EFP RV Monitor — EFP vs OTC Value ($/oz)',
        color=C_TEXT,
        fontsize=13,
        fontweight='bold'
    )

    axes = axes.flatten()

    for idx, metal in enumerate(METALS):
        ax = axes[idx]
        df = efp_data[metal]
        color = METAL_COLORS[metal]
        name = METAL_NAMES[metal]

        contracts = df['Month/Year'].tolist()
        x_pos = np.arange(len(contracts))

        actual = df['EFP Mid'].tolist()
        otc = df['OTC ($/oz)'].tolist()
        rv = df['EFP RV ($/oz)'].tolist()

        ax.plot(x_pos, actual, color=color, marker='o', lw=2, label='EFP Mid')
        ax.plot(x_pos, otc, color=C_MUTED, marker='x', lw=1.5, label='OTC Value')
        ax.bar(x_pos, rv, color=color, alpha=0.25, label='RV = EFP - OTC')

        ax.set_xticks(x_pos)
        ax.set_xticklabels(contracts)
        ax.axhline(0, color=C_MUTED, lw=0.8, ls=':')
        ax.set_title(f'{name} ({metal})', color=color, fontweight='bold')
        ax.set_ylabel('$/oz', color=C_MUTED)
        ax.legend(fontsize=8, loc='best')
        ax.grid(True, alpha=0.3, axis='y')

    plt.tight_layout()
    plt.show()

    # Cash & Carry Chart

    if cash_carry_df is not None and not cash_carry_df.empty:
        plot_df = cash_carry_df.copy()
        plot_df['Label'] = (
            plot_df['Metal']
            + ' '
            + plot_df['Front Month']
            + ' → '
            + plot_df['Deferred Month']
        )

        fig, ax = plt.subplots(figsize=(14, 5), facecolor=BG_DARK)

