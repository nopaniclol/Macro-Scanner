                'Days': row.get('Days'),

                'EFP Mid ($/oz)': row.get('EFP Mid'),
                'OTC ($/oz)': row.get('OTC ($/oz)'),
                'EFP RV ($/oz)': row.get('EFP RV ($/oz)'),

                'Ann Mid (%)': row.get('Ann Mid (%)'),
                'Metal Fwd (%)': row.get('Metal Fwd (%)'),

                'Z-Score': row.get('Z-Score'),
                'Percentile': row.get('Percentile'),
