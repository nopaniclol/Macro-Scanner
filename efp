        x_pos = np.arange(len(contracts))
        z_scores = pd.to_numeric(df['Z-Score'], errors='coerce').tolist()

        bar_colors = []

        for z in z_scores:
            if pd.isna(z):
                bar_colors.append(C_MUTED)
            elif z >= 1:
                bar_colors.append(C_RED)
            elif z <= -1:
                bar_colors.append(C_GREEN)
            else:
                bar_colors.append(C_MUTED)

        ax.bar(x_pos, z_scores, color=bar_colors, alpha=0.8)

        ax.axhline(2, color=C_RED, lw=0.8, ls='--')
        ax.axhline(1, color=C_RED, lw=0.8, ls=':')
        ax.axhline(0, color=C_MUTED, lw=0.8, ls='-')
        ax.axhline(-1, color=C_GREEN, lw=0.8, ls=':')
        ax.axhline(-2, color=C_GREEN, lw=0.8, ls='--')

        ax.set_xticks(x_pos)
        ax.set_xticklabels(contracts)
        ax.set_title(f'{name} ({metal})', color=color, fontweight='bold')
        ax.set_ylabel('Z-Score', color=C_MUTED)
        ax.grid(True, alpha=0.3, axis='y')

    plt.tight_layout()
    plt.show()

    # Switch Charts

    switch_labels = [f'{a}→{b}' for a, b in SWITCH_PAIRS]
    x = np.arange(len(SWITCH_PAIRS))
    w = 0.18

    offsets = np.linspace(
