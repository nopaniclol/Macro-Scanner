def on_save_click(b):
    try:
        save_forward_curves(verbose=True)

        status_label.value = (
            f"✅ Inputs saved at {datetime.now().strftime('%H:%M:%S')}"
        )

    except Exception as e:
        status_label.value = f"❌ Save error: {str(e)}"
        import traceback
        traceback.print_exc()


def on_refresh_click(b):
    b.disabled = True
    b.description = '⏳ Refreshing...'

    status_label.value = (
        f"🔄 Refreshing at {datetime.now().strftime('%H:%M:%S')}..."
    )

    try:
        # Force-save current widget values before any redraw or data refresh.
        save_forward_curves(verbose=True)

        fetch_all_data()

        tables_html.value = generate_all_tables_html()

        status_label.value = (
            f"✅ Data refreshed at "
            f"{datetime.now().strftime('%H:%M:%S')} "
            f"| History updated: {HISTORY_FILE}"
        )

    except Exception as e:
        status_label.value = f"❌ Error: {str(e)}"
        import traceback
        traceback.print_exc()

    finally:
        b.disabled = False
        b.description = '🔄 Refresh Data'


save_button.on_click(on_save_click)
refresh_button.on_click(on_refresh_click)


# ─────────────────────────────────────────────────────────────
#  CELL 11 — Initial Display / Initial Load
# ─────────────────────────────────────────────────────────────

display_forward_inputs()

display(widgets.VBox([
    widgets.HBox([
        save_button,
        refresh_button
    ]),
    status_label,
    tables_html
]))

status_label.value = "🔄 Loading initial data..."

try:
    # Save current widget state before initial load.
    save_forward_curves(verbose=False)

    fetch_all_data()

    tables_html.value = generate_all_tables_html()

    status_label.value = (
        f"✅ Data loaded at {datetime.now().strftime('%H:%M:%S')} "
        f"| History updated: {HISTORY_FILE}"
    )

except Exception as e:
    status_label.value = f"❌ Error during initial load: {str(e)}"
    import traceback
    traceback.print_exc()

print("\n✅ Refresh button ready — pure EFP RV, OTC comparison, cash & carry funding costs, metal forwards and historical store active")
