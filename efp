def normalise_forward_curves(curves):
    clean = {}

    for metal in METALS:
        clean[metal] = {}

        for tenor in METAL_FORWARD_TENORS:
            default_val = DEFAULT_METAL_FORWARD_CURVES.get(metal, {}).get(tenor, np.nan)

            try:
                val = curves.get(metal, {}).get(tenor, default_val)
                clean[metal][tenor] = float(val)
            except Exception:
                clean[metal][tenor] = float(default_val)

    return clean


def load_saved_forward_curves():
    if not os.path.exists(FORWARD_CURVE_LATEST_FILE):
        return normalise_forward_curves(DEFAULT_METAL_FORWARD_CURVES)

    try:
        df = pd.read_csv(FORWARD_CURVE_LATEST_FILE)

        required_cols = ['Metal', 'Tenor', 'Rate (%)']

        if not all(c in df.columns for c in required_cols):
            return normalise_forward_curves(DEFAULT_METAL_FORWARD_CURVES)

        curves = {}

        for metal in METALS:
            curves[metal] = {}
            sub = df[df['Metal'] == metal]

            for tenor in METAL_FORWARD_TENORS:
                row = sub[sub['Tenor'] == tenor]

                if not row.empty:
                    curves[metal][tenor] = float(row.iloc[-1]['Rate (%)'])
                else:
                    curves[metal][tenor] = DEFAULT_METAL_FORWARD_CURVES[metal][tenor]

        return normalise_forward_curves(curves)

    except Exception as e:
        print(f"⚠ Could not load saved forward curves. Using defaults. Error: {e}")
        return normalise_forward_curves(DEFAULT_METAL_FORWARD_CURVES)


