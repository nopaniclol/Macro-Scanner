def load_efp_history():
    try:
        hist = pd.read_csv(HISTORY_FILE)

        if 'Timestamp' in hist.columns:
            hist['Timestamp'] = pd.to_datetime(hist['Timestamp'])

        return hist

    except Exception:
        return pd.DataFrame()


def save_efp_history(new_rows):
    new_df = pd.DataFrame(new_rows)

    if new_df.empty:
        return

    old_df = load_efp_history()
    hist = pd.concat([old_df, new_df], ignore_index=True)

    dedupe_cols = ['Timestamp', 'Metal', 'Contract', 'Month/Year']
    existing_cols = [c for c in dedupe_cols if c in hist.columns]

    if existing_cols:
        hist = hist.drop_duplicates(subset=existing_cols, keep='last')

    hist.to_csv(HISTORY_FILE, index=False)


def get_history_stats(hist, metal, contract, current_value, value_col='EFP RV ($/oz)'):
    output = {
        'Hist Obs': np.nan,
        '1D Δ ($)': np.nan,
        '5D Δ ($)': np.nan,
        '20D Δ ($)': np.nan,
        'Hist Mean ($)': np.nan,
        'Hist Std ($)': np.nan,
        'Z-Score': np.nan,
        'Percentile': np.nan,
        'Signal': 'No history',
    }

    if hist is None or hist.empty:
        return output

    required_cols = ['Timestamp', 'Metal', 'Contract', value_col]

    if not all(c in hist.columns for c in required_cols):
        return output

    h = hist[
        (hist['Metal'] == metal) &
        (hist['Contract'] == contract)
    ].copy()

    if h.empty or pd.isna(current_value):
        return output

    h['Timestamp'] = pd.to_datetime(h['Timestamp'])
    h['Date'] = h['Timestamp'].dt.date
    h = h.sort_values('Timestamp')

    h_daily = h.groupby('Date', as_index=False).tail(1)
    series = pd.to_numeric(h_daily[value_col], errors='coerce').dropna()

    if series.empty:
        return output

    output['Hist Obs'] = int(len(series))

    if len(series) >= 1:
        output['1D Δ ($)'] = current_value - series.iloc[-1]
    if len(series) >= 5:
        output['5D Δ ($)'] = current_value - series.iloc[-5]
    if len(series) >= 20:
        output['20D Δ ($)'] = current_value - series.iloc[-20]

    hist_window = series.tail(252)

    mean = hist_window.mean()
    std = hist_window.std(ddof=1)

    output['Hist Mean ($)'] = mean
    output['Hist Std ($)'] = std

    if pd.notna(std) and std != 0:
        z = (current_value - mean) / std
        output['Z-Score'] = z
        output['Signal'] = classify_rich_cheap(z)

    output['Percentile'] = (hist_window <= current_value).mean() * 100

    return output


