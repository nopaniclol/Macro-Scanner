    return out.reset_index(drop=True)


def build_cash_carry_table(efp_data):
    rows = []

    for metal in METALS:
        df = efp_data[metal].copy()

        if 'C1' not in df.index:
            continue

        front = df.loc['C1']

        front_efp = front.get('EFP Mid')
        front_days = front.get('Days')
        spot_mid = front.get('Spot Mid')

        trigger = (
            pd.notna(front_efp) and
            isinstance(front_efp, (float, int, np.float64, np.int64)) and
            front_efp < 0
        )

        capital_used = (
            spot_mid + front_efp
            if pd.notna(spot_mid) and pd.notna(front_efp)
            else np.nan
        )

        for contract in ['C2', 'C3', 'C4']:
            if contract not in df.index:
                continue

            far = df.loc[contract]

            far_efp = far.get('EFP Mid')
            far_days = far.get('Days')

            gross_spread = np.nan
            hold_days = np.nan
            hold_sofr = np.nan
            hold_funding_cost = np.nan
            carry_cost = np.nan
            net_carry = np.nan
            carry_per_day = np.nan
            roc_pct = np.nan
            roc_ann_pct = np.nan

            if pd.notna(front_efp) and pd.notna(far_efp) and pd.notna(front_days) and pd.notna(far_days):
                hold_days = far_days - front_days
                gross_spread = far_efp - front_efp

                if hold_days > 0:
                    hold_sofr = interpolate_sofr_rate(hold_days)
                    hold_funding_cost = interpolate_funding_cost_rate(hold_days)

                    carry_cost = carry_cost_dollar(
                        spot_mid=spot_mid,
                        funding_cost_pct=hold_funding_cost,
                        insurance_pct=INSURANCE_RATE_PCT,
                        days=hold_days
                    )

                    net_carry = (
                        gross_spread - carry_cost
                        if pd.notna(gross_spread) and pd.notna(carry_cost)
                        else np.nan
                    )

                    carry_per_day = (
                        net_carry / hold_days
                        if pd.notna(net_carry) and pd.notna(hold_days) and hold_days > 0
                        else np.nan
                    )

                    roc_pct = (
                        net_carry / capital_used * 100
                        if pd.notna(net_carry) and pd.notna(capital_used) and capital_used > 0
                        else np.nan
                    )

                    roc_ann_pct = (
                        roc_pct * 360 / hold_days
                        if pd.notna(roc_pct) and pd.notna(hold_days) and hold_days > 0
                        else np.nan
                    )

            rows.append({
                'Metal': metal,
                'Name': METAL_NAMES.get(metal, metal),

                'Front Month': front.get('Month/Year'),
                'Deferred Month': far.get('Month/Year'),

                'Front EFP ($/oz)': front_efp,
                'Deferred EFP ($/oz)': far_efp,

                'Hold Days': hold_days,
                'Hold SOFR (%)': hold_sofr,
                'SOFR Spread (%)': get_sofr_spread(),
                'Hold Funding Cost (%)': hold_funding_cost,
                'Insurance (%)': INSURANCE_RATE_PCT,

                'Gross Carry Spread ($/oz)': gross_spread,
                'Carry Cost ($/oz)': carry_cost,
                'Net Cash Carry ($/oz)': net_carry,
                'Carry Per Day ($/oz/day)': carry_per_day,

                'Capital Used ($/oz)': capital_used,
                'ROC (%)': roc_pct,
                'Annualised ROC (%)': roc_ann_pct,

                'Delivery Trigger': 'Yes' if trigger else 'No',
                'Signal': (
                    'Attractive' if pd.notna(net_carry) and net_carry > 0 and trigger else
                    'Positive but no trigger' if pd.notna(net_carry) and net_carry > 0 and not trigger else
                    'Not attractive'
                ),
            })

    out = pd.DataFrame(rows)

    if out.empty:
        return out

    out['SortScore'] = pd.to_numeric(out['Annualised ROC (%)'], errors='coerce')
    out = out.sort_values('SortScore', ascending=False)
    out = out.drop(columns=['SortScore'])

    return out.reset_index(drop=True)


