def days_to_value(fnd_date, spot_dt):
    """
    Current convention:
        Days = FND + 1 business day - Spot value date
    """
    if fnd_date is None:
        return None

    fnd_value = pd.bdate_range(start=fnd_date, periods=2)[-1].date()
    return max((fnd_value - spot_dt).days, 1)


