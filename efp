def fetch_bid_ask(tickers):
    if isinstance(tickers, str):
        tickers = [tickers]

    tkr_str = ', '.join(f"'{t}'" for t in tickers)
    result = {t: {'bid': np.nan, 'ask': np.nan, 'mid': np.nan} for t in tickers}

    try:
        resp_bid = bq.execute(f"get(px_bid) for([{tkr_str}])")
        df_bid = resp_bid[0].df()

        resp_ask = bq.execute(f"get(px_ask) for([{tkr_str}])")
        df_ask = resp_ask[0].df()

        for t in tickers:
            try:
                bid = df_bid.loc[t, 'px_bid'] if 'px_bid' in df_bid.columns else np.nan
                ask = df_ask.loc[t, 'px_ask'] if 'px_ask' in df_ask.columns else np.nan

                bid = float(bid) if pd.notna(bid) else np.nan
                ask = float(ask) if pd.notna(ask) else np.nan

                if not (np.isnan(bid) or np.isnan(ask)):
                    result[t] = {
                        'bid': bid,
                        'ask': ask,
                        'mid': (bid + ask) / 2,
                    }

            except Exception:
                pass

    except Exception as e:
        print(f"  ⚠ fetch_bid_ask error: {e}")

    return result


def fetch_last(tickers):
    if isinstance(tickers, str):
        tickers = [tickers]

    tkr_str = ', '.join(f"'{t}'" for t in tickers)
    result = {t: np.nan for t in tickers}

    try:
        resp = bq.execute(f"get(px_last) for([{tkr_str}])")
        df = resp[0].df()

        for t in tickers:
            try:
                val = df.loc[t, 'px_last'] if 'px_last' in df.columns else np.nan
                result[t] = float(val) if pd.notna(val) else np.nan
            except Exception:
                result[t] = np.nan

    except Exception as e:
        print(f"  ⚠ fetch_last error: {e}")

    return result


