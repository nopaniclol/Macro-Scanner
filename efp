    return {
        tenor: fallback
        for tenor in SOFR_CURVE_TICKERS.keys()
    }


def interpolate_curve_by_days(curve, days):
    if days is None or days == '—' or pd.isna(days):
        return np.nan

    points = []

    for tenor, rate in curve.items():
        d = TENOR_DAYS.get(tenor)

        if d is not None and pd.notna(rate):
            points.append((float(d), float(rate)))

    if not points:
        return np.nan

    points = sorted(points, key=lambda x: x[0])

    x_days = np.array([p[0] for p in points], dtype=float)
    y_rates = np.array([p[1] for p in points], dtype=float)

    return float(np.interp(float(days), x_days, y_rates))


def interpolate_sofr_rate(days):
    global current_sofr_curve

    if current_sofr_curve is None or len(current_sofr_curve) == 0:
        return np.nan

    return interpolate_curve_by_days(current_sofr_curve, days)


def interpolate_funding_cost_rate(days):
    """
    Used only for cash & carry economics.
    """
    sofr = interpolate_sofr_rate(days)

    if pd.isna(sofr):
        return np.nan

    return sofr + get_sofr_spread()


def interpolate_metal_forward_rate(metal, days):
    curves = get_current_forward_curves()
    curve = curves.get(metal, {})

    return interpolate_curve_by_days(curve, days)


def otc_value_dollar(spot_mid, metal_fwd_pct, days):
    """
    OTC value in $/oz based on desk metal forward curve.

    OTC = Spot × Metal Forward % × Days / 360
    """
    if pd.isna(spot_mid) or pd.isna(metal_fwd_pct) or pd.isna(days) or days == '—':
        return np.nan

    return spot_mid * (metal_fwd_pct / 100.0) * (float(days) / 360.0)


def carry_cost_dollar(spot_mid, funding_cost_pct, insurance_pct, days):
    """
    Carry cost in $/oz.

    Carry Cost = Spot × (Funding Cost + Insurance) × Days / 360.
    Funding Cost = SOFR + SOFR Spread.
    Used only for cash & carry.
    """
    if pd.isna(spot_mid) or pd.isna(funding_cost_pct) or pd.isna(days) or days == '—':
        return np.nan

    total_carry_pct = funding_cost_pct + insurance_pct

    return spot_mid * (total_carry_pct / 100.0) * (float(days) / 360.0)


def classify_rich_cheap(z):
    if pd.isna(z):
        return 'No history'
    if z >= 2.0:
        return 'Very Rich'
    if z >= 1.0:
        return 'Rich'
    if z <= -2.0:
        return 'Very Cheap'
    if z <= -1.0:
        return 'Cheap'
    return 'Fair'


def signal_color(signal):
    if signal in ['Very Rich', 'Rich']:
        return C_RED
    if signal in ['Very Cheap', 'Cheap']:
        return C_GREEN
    if signal == 'Fair':
        return C_MUTED
    return C_MUTED


def _cell_color_num(v):
    if not isinstance(v, (float, int, np.float64, np.int64)) or pd.isna(v):
        return ''
    return f'color:{C_GREEN}' if v > 0 else f'color:{C_RED}'


def _cell_color_rv(v):
    """
    Positive RV = EFP rich / opportunity to sell EFP.
    Negative RV = EFP cheap / opportunity to buy EFP.
    """
    if not isinstance(v, (float, int, np.float64, np.int64)) or pd.isna(v):
        return ''
    return f'color:{C_RED}' if v > 0 else f'color:{C_GREEN}'


def _cell_color_z(v):
    if not isinstance(v, (float, int, np.float64, np.int64)) or pd.isna(v):
        return ''
    if v >= 1:
        return f'color:{C_RED}'
    if v <= -1:
        return f'color:{C_GREEN}'
