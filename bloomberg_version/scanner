def plot_rsi_heatmap(
    dataframe: pd.DataFrame,
    ncols: int = 5,
    cell_size=(1.9, 1.3),
) -> None:
    """
    Plot current 14-day RSI using:
        low RSI = blue
        middle RSI = yellow
        high RSI = red
    """

    data = (
        dataframe[
            ["label", "rsi_raw"]
        ]
        .dropna(
            subset=["rsi_raw"]
        )
        .sort_values(
            "rsi_raw",
            ascending=False,
        )
    )

    number_of_instruments = len(data)

    if number_of_instruments == 0:
        print(
            "No RSI data available to plot."
        )
        return

    number_of_rows = -(
        -number_of_instruments
        // ncols
    )

    figure, axis = plt.subplots(
        figsize=(
            cell_size[0] * ncols,
            cell_size[1] * number_of_rows,
        )
    )

    colour_map = plt.get_cmap(
        "RdYlBu_r"
    )

    normalisation = mcolors.Normalize(
        vmin=0,
        vmax=100,
    )

    for index, (
        symbol,
        row,
    ) in enumerate(data.iterrows()):

        row_number, column_number = divmod(
            index,
            ncols,
        )

        y_position = (
            number_of_rows
            - row_number
            - 1
        )

        colour = colour_map(
            normalisation(
                row["rsi_raw"]
            )
        )

        axis.add_patch(
            patches.Rectangle(
                (
                    column_number,
                    y_position,
                ),
                1,
                1,
                facecolor=colour,
                edgecolor="white",
                linewidth=2,
            )
        )

        luminance = (
            0.299 * colour[0]
            + 0.587 * colour[1]
            + 0.114 * colour[2]
        )

        text_colour = (
            "white"
            if luminance < 0.55
            else "black"
        )

        label = (
            row["label"]
            if pd.notna(row["label"])
            else symbol
        )

        axis.text(
            column_number + 0.5,
            y_position + 0.62,
            label,
            ha="center",
            va="center",
            fontsize=10,
            fontweight="bold",
            color=text_colour,
        )

        axis.text(
            column_number + 0.5,
            y_position + 0.30,
            f'{row["rsi_raw"]:.0f}',
            ha="center",
            va="center",
            fontsize=11,
            color=text_colour,
        )

    axis.set_xlim(
        0,
        ncols,
    )

    axis.set_ylim(
        0,
        number_of_rows,
    )

    axis.set_xticks([])
    axis.set_yticks([])
    axis.set_aspect("equal")

    for spine in axis.spines.values():
        spine.set_visible(False)

    axis.set_title(
        "Tracked-Instrument RSI Heatmap\n"
        "Current 14-day RSI",
        fontsize=13,
        fontweight="bold",
    )

    plt.tight_layout()
    plt.show()


