# =============================================================================
# GENERAL HELPERS
# =============================================================================

def clean_series(series: pd.Series) -> pd.Series:
    """
    Convert a series to numeric, remove missing values and duplicate dates,
    and return it in chronological order.
    """

    output = pd.to_numeric(series, errors="coerce").dropna().copy()
    output.index = pd.to_datetime(output.index)

    output = output[
        ~output.index.duplicated(keep="last")
    ].sort_index()

    return output


def available_count(values) -> int:
    """
    Count non-null values.
    """

    return sum(
        value is not None and not pd.isna(value)
        for value in values
    )


def weighted_mean(
    items: Dict[str, Optional[float]],
    weights: Dict[str, float],
    min_components: int = 1,
) -> Optional[float]:"""
    Calculate a weighted average using only available components.

    If one component is unavailable, the remaining weights are re-normalised.
    """

    valid_items = {
        key: float(value)
        for key, value in items.items()
        if (
            value is not None
            and not pd.isna(value)
            and weights.get(key, 0.0) > 0
        )
    }

    if len(valid_items) < min_components:
        return None

    denominator = sum(
        weights[key]
        for key in valid_items
    )

    if denominator == 0:
        return None

    numerator = sum(
        valid_items[key] * weights[key]
        for key in valid_items
    )

    return round(numerator / denominator, 2)


# =============================================================================
# SCORE FUNCTIONS
# =============================================================================

def percentile_score(
    value,
    history: pd.Series,
) -> Optional[float]:"""
    Convert a value's historical percentile into a -10 to +10 score.
    """

    history = clean_series(history)

    if (
        value is None
        or pd.isna(value)
        or len(history) < 20
    ):
        return None

    percentile = (history <= value).mean() * 100.0

    score = (
        (percentile - 50.0)
        / 50.0
        * 10.0
    )

    return round(score, 2)


def zscore_series(
    series: pd.Series,
    lookback: Optional[int] = None,
    cap: float = ZSCORE_CAP,
) -> pd.Series:
    """
    Convert a full historical series into capped -10 to +10 z-scores.

    If lookback is None, expanding statistics are used.
    Otherwise, rolling statistics are used.
    """

    series = clean_series(series)

    if lookback is None:
        mean = series.expanding(
            min_periods=20
        ).mean()

        std = series.expanding(
            min_periods=20
        ).std()

    else:
        mean = series.rolling(
            lookback,
            min_periods=20,
        ).mean()

        std = series.rolling(
            lookback,
            min_periods=20,
        ).std()

    std = std.replace(0, np.nan)

    zscore = (
        (series - mean)
        / std
    ).clip(
        lower=-cap,
        upper=cap,
    )

    return zscore / cap * 10.0


def rolling_percentile_score(
    series: pd.Series,
    years: int = ROLLING_PERCENTILE_YEARS,
) -> pd.Series:
    """
    Calculate a rolling percentile score on a weekly series.
    """

    series = clean_series(series)

    weekly_window = max(
        int(years * 52),
        20,
    )

    def score_window(values):
        if len(values) < 20:
            return np.nan

        current_value = values[-1]

        if pd.isna(current_value):
            return np.nan

        percentile = np.mean(
            values <= current_value
        ) * 100.0

        return (
            (percentile - 50.0)
            / 50.0
            * 10.0
        )

    return series.rolling(
        weekly_window,
        min_periods=20,
    ).apply(
        score_window,
        raw=True,
    )


