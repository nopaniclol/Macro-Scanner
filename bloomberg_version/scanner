            round(
                latest["cftc_positioning"],
                2,
            )
            if pd.notna(
                latest["cftc_positioning"]
            )
            else None
        ),
    }

    return history, summary


# =============================================================================
# RISK-REVERSAL FUNCTIONS
# =============================================================================

def fetch_risk_reversal_history(
    symbol: str,
    instrument: dict,
) -> Tuple[pd.DataFrame, dict]:
    """
    Download and score 1M and 6M 25-delta risk reversals.
    """

    root = instrument.get(
        "rr_root"
    )

    if not root:
        return pd.DataFrame(), {
            "rr_1m": None,
            "rr_6m": None,
            "options_skew": None,
            "rr_component_count": 0,
        }

    output_series = []
    summary = {}

    rr_sign = float(
        instrument.get(
            "rr_sign",
            1.0,
        )
    )

    tenor_mapping = (
        ("1M", "rr_1m"),
        ("6M", "rr_6m"),
    )

    for tenor, output_key in tenor_mapping:
        ticker = (
            f"{root}"
            f"25R{tenor} "
            f"BGN Curncy"
        )

        try:
            raw_series = (
                fetch_series_bql(
                    ticker,
                    RR_HISTORY_START,
                )
                * rr_sign
            )

            score_series = zscore_series(
                raw_series,
                lookback=RR_ZSCORE_LOOKBACK,
            )

            output_series.append(
                raw_series.rename(
                    f"{output_key}_raw"
                )
            )

            output_series.append(
                score_series.rename(
                    output_key
                )
            )

            if (
                len(score_series)
                and pd.notna(
                    score_series.iloc[-1]
                )
            ):
                summary[output_key] = round(
                    score_series.iloc[-1],
                    2,
                )
            else:
                summary[output_key] = None

        except Exception as exception:
            print(
                f"  [warn] RR fetch failed for "
                f"{symbol} {tenor} ({ticker}): "
                f"{exception}"
            )

            summary[output_key] = None

    if output_series:
        history = pd.concat(
            output_series,
            axis=1,
        )
    else:
        history = pd.DataFrame()

    score_columns = [
        column
        for column in (
            "rr_1m",
            "rr_6m",
        )
        if column in history.columns
    ]

    if score_columns:
        history["options_skew"] = history[
            score_columns
        ].mean(
            axis=1
        )

        latest_skew = history[
            "options_skew"
        ].dropna()

        summary["options_skew"] = (
            round(
                latest_skew.iloc[-1],
                2,
            )
            if len(latest_skew)
            else None
        )

    else:
        summary["options_skew"] = None

    summary["rr_component_count"] = available_count(
        [
            summary.get("rr_1m"),
            summary.get("rr_6m"),
        ]
    )

    return history, summary


# =============================================================================
# HISTORICAL SIGNAL ALIGNMENT
# =============================================================================

def align_weekly_to_daily(
    daily_index: pd.DatetimeIndex,
    weekly_history: pd.DataFrame,
) -> pd.DataFrame:
    """
    Forward-fill weekly CFTC information onto the daily price index.
    """

    if weekly_history.empty:
        return pd.DataFrame(
            index=daily_index
        )

    return weekly_history.reindex(
        daily_index,
        method="ffill",
    )


def build_composite_history(
    momentum_history: pd.DataFrame,
    cftc_history: pd.DataFrame,
    risk_reversal_history: pd.DataFrame,
) -> pd.DataFrame:
    """
    Combine daily prices, daily momentum, weekly CFTC and daily options skew.
    """

    output = momentum_history.copy()

    if not cftc_history.empty:
        aligned_cftc = align_weekly_to_daily(
            output.index,
            cftc_history,
        )

        output = output.join(
            aligned_cftc,
            how="left",
        )

    if not risk_reversal_history.empty:
        output = output.join(
            risk_reversal_history,
            how="left",
        )

    if "cftc_positioning" not in output.columns:
        output["cftc_positioning"] = np.nan

    if "options_skew" not in output.columns:
        output["options_skew"] = np.nan

    output["POSITIONING"] = output.apply(
        lambda row: weighted_mean(
            {
                "cftc_positioning": row[
                    "cftc_positioning"
                ],

                "options_skew": row[
                    "options_skew"
                ],
            },
            POSITIONING_WEIGHTS,
            min_components=MIN_POSITIONING_COMPONENTS,
        ),
        axis=1,
    )

    output["positioning_component_count"] = output[
        [
            "cftc_positioning",
            "options_skew",
        ]
    ].notna().sum(
        axis=1
    )

    return output


# =============================================================================
# FORWARD-RETURN ANALYSIS
# =============================================================================

def add_forward_returns(
    history: pd.DataFrame,
    horizons=FORWARD_HORIZONS,
) -> pd.DataFrame:
    """
    Add forward percentage returns for each requested trading-day horizon.
    """

    output = history.copy()

    for horizon in horizons:
        output[
            f"fwd_{horizon}d_return_pct"
        ] = (
            (
                output["price"].shift(
                    -horizon
                )
                / output["price"]
            )
            - 1.0
        ) * 100.0

    return output


def score_bucket(
    series: pd.Series,
) -> pd.Categorical:
    """
    Place -10 to +10 scores into five directional buckets.
    """

    bins = [
        -np.inf,
        -5.0,
        -2.0,
        2.0,
        5.0,
        np.inf,
    ]

    labels = [
        "very_negative",
        "negative",
        "neutral",
        "positive",
        "very_positive",
    ]

    return pd.cut(
        series,
        bins=bins,
        labels=labels,
        include_lowest=True,
    )


def conditional_forward_return_table(
    history: pd.DataFrame,
    signal: str,
    horizons=FORWARD_HORIZONS,
) -> pd.DataFrame:
    """
    Analyse future returns conditional on an individual signal bucket.
    """

    forward_columns = [
        f"fwd_{horizon}d_return_pct"
        for horizon in horizons
    ]

    data = history[
        [signal] + forward_columns
    ].copy()

    data["bucket"] = score_bucket(
        data[signal]
    )

    rows = []

    grouped_data = data.groupby(
        "bucket",
        observed=False,
    )

    for bucket, group in grouped_data:
        for horizon in horizons:
            column = (
                f"fwd_{horizon}d_return_pct"
            )

            values = group[
                column
            ].dropna()

            if len(values):
                hit_rate = (
                    (values > 0).mean()
                    * 100.0
                )
            else:
                hit_rate = np.nan

            rows.append(
                {
                    "signal": signal,
                    "bucket": str(bucket),
                    "horizon_days": horizon,
                    "observations": int(
                        values.count()
                    ),
                    "mean_return_pct": (
                        values.mean()
                    ),
                    "median_return_pct": (
                        values.median()
                    ),
                    "positive_hit_rate_pct": (
                        hit_rate
                    ),
                    "return_std_pct": (
                        values.std()
                    ),
                }
            )

    return pd.DataFrame(rows)


def combined_regime_table(
    history: pd.DataFrame,
    horizons=FORWARD_HORIZONS,
) -> pd.DataFrame:
    """
    Analyse forward returns for combined positioning and momentum regimes.
    """

    data = history.copy()

    data["positioning_bucket"] = score_bucket(
        data["POSITIONING"]
    )

    data["momentum_bucket"] = score_bucket(
        data["MOMENTUM"]
    )

    rows = []

    grouped_data = data.groupby(
        [
            "positioning_bucket",
            "momentum_bucket",
        ],
        observed=False,
    )

    for (
        positioning_bucket,
        momentum_bucket,
    ), group in grouped_data:

        for horizon in horizons:
            column = (
                f"fwd_{horizon}d_return_pct"
            )

            values = group[
                column
            ].dropna()

            if len(values):
                hit_rate = (
                    (values > 0).mean()
                    * 100.0
                )
            else:
                hit_rate = np.nan

            rows.append(
                {
                    "positioning_bucket": str(
                        positioning_bucket
                    ),

                    "momentum_bucket": str(
                        momentum_bucket
                    ),

                    "horizon_days": horizon,

                    "observations": int(
                        values.count()
                    ),

                    "mean_return_pct": (
                        values.mean()
                    ),

                    "median_return_pct": (
                        values.median()
                    ),

                    "positive_hit_rate_pct": (
                        hit_rate
                    ),
                }
            )

    return pd.DataFrame(rows)


# =============================================================================
# SIGNAL INTERPRETATION
# =============================================================================

def concentration_label(
    value,
) -> str:
    """
    Describe positioning without implying expected future direction.
    """

    if value is None or pd.isna(value):
        return "unavailable"

    if value >= 5:
        return "crowded long"

    if value <= -5:
        return "crowded short"

    return "not extreme"


def momentum_label(
    value,
) -> str:
    """
    Describe momentum direction.
    """

    if value is None or pd.isna(value):
        return "unavailable"

    if value >= 5:
        return "strong positive momentum"

    if value <= -5:
        return "strong negative momentum"

    return "not extreme"


def skew_label(
    value,
) -> str:
    """
    Describe options skew in the direction of the named instrument.
    """

    if value is None or pd.isna(value):
        return "unavailable"

    if value >= 5:
        return (
            "strong bullish skew for "
            "named instrument"
        )

    if value <= -5:
        return (
            "strong bearish skew for "
            "named instrument"
        )

    return "not extreme"


def flag_extremes(
    dataframe: pd.DataFrame,
    threshold: float = 5.0,
) -> None:
    """
    Print extreme positioning, options skew and momentum scores.
    """

    print(
        f"--- Extremes "
        f"(|score| >= {threshold}) ---"
    )

    found_extreme = False

    for symbol, row in dataframe.iterrows():
        values = {
            "POSITIONING": (
                row.get("POSITIONING"),
                concentration_label,
            ),

            "OPTIONS_SKEW": (
                row.get("options_skew"),
                skew_label,
            ),

            "MOMENTUM": (
                row.get("MOMENTUM"),
                momentum_label,
            ),
        }

        for name, (
            value,
            label_function,
        ) in values.items():

            if (
                value is not None
                and not pd.isna(value)
                and abs(value) >= threshold
            ):
                print(
                    f"  {symbol} {name}: "
                    f"{value:+.1f} "
                    f"({label_function(value)})"
                )

                found_extreme = True

    if not found_extreme:
        print(
            "  No composite extremes "
            "at the selected threshold."
        )


