def fetch_series_bql(
    ticker: str,
    start_date: str,
) -> pd.Series:
    """
    Download PX_LAST history for one Bloomberg ticker.
    """

    date_range = bq.func.range(
        start_date,
        "0d",
    )

    field = bq.data.px_last(
        dates=date_range
    )

    request = bql.Request(
        ticker,
        {"px_last": field},
    )

    response = bq.execute(request)
    dataframe = bql.combined_df(response)

    required_columns = {
        "DATE",
        "px_last",
    }

    if not required_columns.issubset(dataframe.columns):
        raise ValueError(
            f"Unexpected BQL output for {ticker}. "
            f"Returned columns: {list(dataframe.columns)}"
        )

    series = (
        dataframe[
            ["DATE", "px_last"]
        ]
        .set_index("DATE")["px_last"]
    )

    return clean_series(series)


# =============================================================================
# MOMENTUM FUNCTIONS
# =============================================================================

def compute_rsi(
    prices: pd.Series,
    period: int = 14,
) -> pd.Series:
    """
    Calculate Wilder-style RSI.
    """

    prices = clean_series(prices)

    delta = prices.diff()

    gain = delta.clip(
        lower=0
    )

    loss = -delta.clip(
        upper=0
    )

    average_gain = gain.ewm(
        alpha=1.0 / period,
        min_periods=period,
        adjust=False,
    ).mean()

    average_loss = loss.ewm(
        alpha=1.0 / period,
        min_periods=period,
        adjust=False,
    ).mean()

    relative_strength = (
        average_gain
        / average_loss
    )

    rsi = 100.0 - (
        100.0
        / (1.0 + relative_strength)
    )

    rsi.loc[
        average_loss == 0
    ] = 100.0

    rsi.loc[
        (average_loss == 0)
        & (average_gain == 0)
    ] = 50.0

    return rsi


def rsi_score_series(
    rsi: pd.Series,
) -> pd.Series:
    """
    Convert RSI from 0-100 into a -10 to +10 score.
    """

    return (
        (rsi - 50.0)
        / 50.0
        * 10.0
    )


def deviation_from_ma(
    prices: pd.Series,
    window: int,
) -> pd.Series:
    """
    Calculate percentage deviation from a moving average.
    """

    prices = clean_series(prices)

    moving_average = prices.rolling(
        window,
        min_periods=window,
    ).mean()

    return (
        (prices - moving_average)
        / moving_average
        * 100.0
    )


def build_momentum_history(
    prices: pd.Series,
) -> Tuple[pd.DataFrame, dict]:
    """
    Build full daily momentum history and the current momentum summary.
    """

    rsi_raw = compute_rsi(
        prices,
        period=14,
    )

    rsi_score = rsi_score_series(
        rsi_raw
    )

    deviation_20_raw = deviation_from_ma(
        prices,
        window=20,
    )

    deviation_100_raw = deviation_from_ma(
        prices,
        window=100,
    )

    deviation_20_score = zscore_series(
        deviation_20_raw,
        lookback=DEVIATION_ZSCORE_LOOKBACK,
    )

    deviation_100_score = zscore_series(
        deviation_100_raw,
        lookback=DEVIATION_ZSCORE_LOOKBACK,
    )

    history = pd.concat(
        [
            prices.rename("price"),
            rsi_raw.rename("rsi_raw"),
            rsi_score.rename("rsi"),
            deviation_20_score.rename("dev_20d"),
            deviation_100_score.rename("dev_100d"),
        ],
        axis=1,
    )

    history["MOMENTUM"] = history.apply(
        lambda row: weighted_mean(
            {
                "rsi": row["rsi"],
                "dev_20d": row["dev_20d"],
                "dev_100d": row["dev_100d"],
            },
            MOMENTUM_WEIGHTS,
            min_components=MIN_MOMENTUM_COMPONENTS,
        ),
        axis=1,
    )

    latest = history.iloc[-1]

    summary = {
        "rsi": (
            round(latest["rsi"], 2)
            if pd.notna(latest["rsi"])
            else None
        ),

        "rsi_raw": (
            round(latest["rsi_raw"], 2)
            if pd.notna(latest["rsi_raw"])
            else None
        ),

        "dev_20d": (
            round(latest["dev_20d"], 2)
            if pd.notna(latest["dev_20d"])
            else None
        ),

        "dev_100d": (
            round(latest["dev_100d"], 2)
            if pd.notna(latest["dev_100d"])
            else None
        ),

        "MOMENTUM": (
            round(latest["MOMENTUM"], 2)
            if pd.notna(latest["MOMENTUM"])
            else None
        ),

        "momentum_component_count": available_count(
            [
                latest["rsi"],
                latest["dev_20d"],
                latest["dev_100d"],
            ]
        ),
    }

    return history, summary


