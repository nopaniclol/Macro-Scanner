# CFTC FUNCTIONS
# =============================================================================

def fetch_cftc_history_bql(
    instrument: dict,
    start_date: str = CFTC_HISTORY_START,
) -> Tuple[pd.DataFrame, str]:
    """
    Download CFTC history.

    If long, short and open-interest tickers are all supplied, calculate
    net non-commercial positioning as a percentage of open interest.

    Otherwise, use the direct net-position ticker.
    """

    long_ticker = instrument.get(
        "cftc_long_ticker"
    )

    short_ticker = instrument.get(
        "cftc_short_ticker"
    )

    open_interest_ticker = instrument.get(
        "cftc_oi_ticker"
    )

    net_ticker = instrument.get(
        "cftc_net_ticker"
    )

    if (
        long_ticker
        and short_ticker
        and open_interest_ticker
    ):
        long_series = fetch_series_bql(
            long_ticker,
            start_date,
        )

        short_series = fetch_series_bql(
            short_ticker,
            start_date,
        )

        open_interest = fetch_series_bql(
            open_interest_ticker,
            start_date,
        )

        output = pd.concat(
            [
                long_series.rename("long"),
                short_series.rename("short"),
                open_interest.rename("open_interest"),
            ],
            axis=1,
        ).dropna(
            how="all"
        )

        output["position_metric"] = (
            (
                output["long"]
                - output["short"]
            )
            / output["open_interest"].replace(
                0,
                np.nan,
            )
            * 100.0
        )

        metric_name = "net_noncomm_pct_oi"

    elif net_ticker:
        net_series = fetch_series_bql(
            net_ticker,
            start_date,
        )

        output = net_series.rename(
            "position_metric"
        ).to_frame()

        metric_name = "direct_net_series"

    else:
        return pd.DataFrame(), "none"

    cftc_sign = float(
        instrument.get(
            "cftc_sign",
            1.0,
        )
    )

    output["position_metric"] = (
        output["position_metric"]
        * cftc_sign
    )

    return output.sort_index(), metric_name


def to_weekly_release_series(
    series: pd.Series,
) -> pd.Series:
    """
    Convert CFTC data into one observation per Friday.

    This handles both:
        1. Genuine weekly observations
        2. Daily forward-filled Bloomberg series
    """

    series = clean_series(series)

    return (
        series
        .resample("W-FRI")
        .last()
        .dropna()
    )


def build_positioning_history(
    symbol: str,
    instrument: dict,
) -> Tuple[pd.DataFrame, dict]:
    """
    Build historical CFTC positioning scores and current summary.
    """

    empty_summary = {
        "cftc_metric": None,
        "cftc_level_full": None,
        "cftc_level_rolling": None,
        "cftc_4wk_chg": None,
        "cftc_positioning": None,
    }

    try:
        raw_history, metric_name = fetch_cftc_history_bql(
            instrument
        )

    except Exception as exception:
        print(
            f"  [warn] CFTC fetch failed for {symbol}: "
            f"{exception}"
        )

        return pd.DataFrame(), empty_summary

    if raw_history.empty:
        return pd.DataFrame(), empty_summary

    weekly_position = to_weekly_release_series(
        raw_history["position_metric"]
    )

    if weekly_position.empty:
        return pd.DataFrame(), empty_summary

    full_history_level = weekly_position.expanding(
        min_periods=20
    ).apply(
        lambda values: (
            (
                np.mean(
                    values <= values[-1]
                )
                * 100.0
                - 50.0
            )
            / 50.0
            * 10.0
        ),
        raw=True,
    )

    rolling_level = rolling_percentile_score(
        weekly_position,
        years=ROLLING_PERCENTILE_YEARS,
    )

    change_4_week_raw = weekly_position.diff(
        4
    )

    change_4_week_score = zscore_series(
        change_4_week_raw,
        lookback=CFTC_CHANGE_ZSCORE_LOOKBACK,
    )

    history = pd.concat(
        [
            weekly_position.rename(
                "cftc_metric_raw"
            ),

            full_history_level.rename(
                "cftc_level_full"
            ),

            rolling_level.rename(
                "cftc_level_rolling"
            ),

            change_4_week_score.rename(
                "cftc_4wk_chg"
            ),
        ],
        axis=1,
    )

    history["cftc_positioning"] = history[
        [
            "cftc_level_rolling",
            "cftc_4wk_chg",
        ]
    ].mean(
        axis=1
    )

    latest = history.iloc[-1]

    summary = {
        "cftc_metric": metric_name,

        "cftc_level_full": (
            round(
                latest["cftc_level_full"],
                2,
            )
            if pd.notna(
                latest["cftc_level_full"]
            )
            else None
        ),

        "cftc_level_rolling": (
